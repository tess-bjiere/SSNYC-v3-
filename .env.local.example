# SSYNC — connects to your EXISTING Supabase project (all current data lives here).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Set to "true" to preview the UI locally WITHOUT Google login (dev only).
# Leave unset / "false" in production so the real allowlisted Google login is enforced.
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# Set to "1" to preview with built-in DEMO data (no database needed).
# NEXT_PUBLIC_MOCK=1
